  "rules": [
    {
      "category": "Refund/Reversal",
      "direction": "credit",
      "regex": "\\b(refund|reversal|rev|cashback|rfd|chargeback)\\b",
      "priority": 100
    },
    {
      "category": "Salary/Income",
      "direction": "credit",
      "regex": "\\b(salary|sal credit|payroll|stipend|wages|bonus|cms/|client.*invoice)\\b",
      "priority": 95
    },
    {
      "category": "Interest Earned",
      "direction": "credit",
      "regex": "\\b(interest credit|int\\.pd|sb interest|quarterly interest|savings interest)\\b",
      "priority": 90
    },
    {
      "category": "Cash Deposit",
      "direction": "credit",
      "regex": "\\b(cash dep|by cash|cdm deposit|cash deposit)\\b",
      "priority": 85
    },
    {
      "category": "Transfer In",
      "direction": "credit",
      "regex": "\\b(neft cr|imps.*cr|upi.*cr|transfer from|ft from|received from)\\b",
      "priority": 70
